# FirstDraft API environment template.
#
# Copy this file to api/.env for local source development:
#
#   cp .env.example .env
#
# The API loads this file through dotenv when it starts. The checked-in values
# are intended for local development with the root docker-compose.yml Postgres
# and MinIO services. Replace all secrets before using a shared, hosted, or
# production environment.

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
#
# HTTP port the Express API listens on.
#
# Defaults to 5080 when omitted. The Docker compose file also maps host port
# 5080 to this container port by default.
PORT=5080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
#
# Required. Postgres connection string used by TypeORM. The API runs migrations
# on startup against this database.
#
# Local compose defaults:
#   database: firstdraft
#   username: firstdraft
#   password: firstdraft
#   host: localhost
#   port: 5432
DATABASE_URL=postgres://firstdraft:firstdraft@localhost:5432/firstdraft

# -----------------------------------------------------------------------------
# User auth JWT
# -----------------------------------------------------------------------------
#
# JWT_SECRET is required in production. In non-production the code has a
# dev-only fallback, but keeping an explicit local value avoids surprises.
#
# Use a long random value for real deployments. Do not reuse the sample value.
JWT_SECRET=change-this-local-development-secret

# Lifetime for signed-in web-console user access tokens. Any jsonwebtoken
# duration accepted by the underlying library is valid, such as 1h, 12h, or 1d.
# Defaults to 1h when omitted.
JWT_EXPIRES_IN=1d

# Issuer and audience that are embedded in user JWTs and verified on requests.
# Change these only when all API instances and clients agree on the values.
JWT_ISSUER=firstdraft-api
JWT_AUDIENCE=firstdraft-web

# -----------------------------------------------------------------------------
# Worker auth JWT
# -----------------------------------------------------------------------------
#
# Worker JWTs authenticate worker-to-API requests separately from web-console
# user JWTs.
#
# Optional. If omitted, WORKER_JWT_SECRET falls back to JWT_SECRET. For
# production, prefer a separate long random value so worker tokens and user
# tokens have independent signing keys.
WORKER_JWT_SECRET=change-this-local-worker-jwt-secret

# Issuer and audience for worker JWTs. Defaults are shown below.
WORKER_JWT_ISSUER=firstdraft-api
WORKER_JWT_AUDIENCE=firstdraft-worker-api

# -----------------------------------------------------------------------------
# Optional on-site worker authentication
# -----------------------------------------------------------------------------
#
# Leave both values unset for the normal hosted flow where each worker is
# initialized by signing in as a FirstDraft user.
#
# Set both values to enable single-customer/on-site worker authentication.
# Workers configured with the same WORKER_API_KEY and WORKER_API_SECRET can
# exchange those credentials for worker JWTs without user login/signup.
#
# Both values must be set together. Setting only one causes API startup to fail.
# WORKER_API_KEY=change-this-worker-api-key
# WORKER_API_SECRET=change-this-worker-api-secret

# -----------------------------------------------------------------------------
# Tenant administration
# -----------------------------------------------------------------------------
#
# Admin key used by tenant administration flows. Treat it as a secret. Replace
# this value before exposing the API beyond local development.
TENANT_ADMIN_KEY=change-this-local-admin-key

# -----------------------------------------------------------------------------
# Command output object storage
# -----------------------------------------------------------------------------
#
# Command output is stored as NDJSON chunks in object storage when a bucket or
# container is configured. If COMMAND_OUTPUT_BUCKET is omitted, the API still
# runs, but durable command output storage is disabled.
#
# Provider aliases:
#   s3, aws       -> S3-compatible storage
#   gcs, google   -> Google Cloud Storage
#   azure, az     -> Azure Blob Storage
#
# Defaults to s3 when omitted.
COMMAND_OUTPUT_STORAGE_PROVIDER=s3

# Required only when command output storage should be enabled. For Azure, this
# is the Blob container name. For S3/GCS, this is the bucket name.
COMMAND_OUTPUT_BUCKET=firstdraft-command-output

# Optional path prefix prepended to stored command output object keys. Useful to
# separate environments that share a bucket, such as dev/, staging/, or prod/.
COMMAND_OUTPUT_PREFIX=dev/

# -----------------------------------------------------------------------------
# S3/AWS-compatible settings
# -----------------------------------------------------------------------------
#
# These values match the MinIO service in the root docker-compose.yml. For real
# AWS S3, remove S3_ENDPOINT_URL and S3_FORCE_PATH_STYLE unless your deployment
# needs a custom endpoint or path-style access.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# Truthy values are 1, true, yes, or on. Set true for local MinIO.
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Google Cloud Storage settings
# -----------------------------------------------------------------------------
#
# Used when COMMAND_OUTPUT_STORAGE_PROVIDER=gcs or google.
#
# Authentication uses Google Application Default Credentials. Set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file when ADC is not
# already available in the runtime environment. Project ID can come from either
# GCP_PROJECT_ID or GOOGLE_CLOUD_PROJECT.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# -----------------------------------------------------------------------------
# Azure Blob Storage settings
# -----------------------------------------------------------------------------
#
# Used when COMMAND_OUTPUT_STORAGE_PROVIDER=azure or az.
#
# Prefer AZURE_STORAGE_CONNECTION_STRING when available. Otherwise provide both
# AZURE_STORAGE_ACCOUNT_NAME and AZURE_STORAGE_ACCOUNT_KEY.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
