# API server
PORT=5080

# Database
DATABASE_URL=postgres://firstdraft:firstdraft@localhost:5432/firstdraft

# User auth JWT
JWT_SECRET=change-this-local-development-secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=firstdraft-api
JWT_AUDIENCE=firstdraft-web

# Worker auth JWT (optional; falls back to JWT_SECRET if omitted)
WORKER_JWT_SECRET=change-this-local-worker-jwt-secret
WORKER_JWT_ISSUER=firstdraft-api
WORKER_JWT_AUDIENCE=firstdraft-worker-api

# Optional on-site worker authentication. Set both values to let workers
# exchange these credentials for worker JWTs instead of authenticating as users.
# WORKER_API_KEY=change-this-worker-api-key
# WORKER_API_SECRET=change-this-worker-api-secret

# Tenant administration
TENANT_ADMIN_KEY=change-this-local-admin-key

# Command output object storage
# Provider: s3|aws|gcs|google|azure|az (defaults to s3)
COMMAND_OUTPUT_STORAGE_PROVIDER=s3
COMMAND_OUTPUT_BUCKET=firstdraft-command-output
COMMAND_OUTPUT_PREFIX=dev/

# S3/AWS-compatible settings
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# GCS settings (used when COMMAND_OUTPUT_STORAGE_PROVIDER=gcs)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Azure Blob Storage settings (used when COMMAND_OUTPUT_STORAGE_PROVIDER=azure)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
