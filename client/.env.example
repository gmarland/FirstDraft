# FirstDraft worker environment template.
#
# Copy this file to client/.env, or to a .env file in whichever directory you
# run the worker from next to config.json:
#
#   cp .env.example .env
#
# The worker loads supported values from .env over config.json. During
# `firstdraft init`, values present here are accepted and not prompted for.
#
# For the hosted FirstDraft API, leave WORKER_API_KEY and WORKER_API_SECRET
# unset and run `firstdraft init` to log in or sign up.
#
# For a single-customer/on-site API that has WORKER_API_KEY and
# WORKER_API_SECRET configured, set the same values in this file so the worker
# can authenticate without a user login/signup prompt.

# Stable worker identifier shown to the API and web console.
#
# Keep this stable after the worker has registered. Use lowercase letters,
# numbers, and hyphen-like simple identifiers to avoid hostname/subdomain issues
# in places that derive URLs from the worker ID.
FIRSTDRAFT_WORKER_ID=my-worker

# Base URL for the FirstDraft API from this worker machine.
#
# Hosted default:
#   https://api.firstdraft.run
#
# Local API from source or root docker-compose.yml:
#   http://localhost:5080
#
# Must be an absolute http:// or https:// URL. Do not include a trailing slash.
FIRSTDRAFT_EXTERNAL_API=https://api.firstdraft.run

# AI execution provider. Supported values are currently:
#   Codex
#   Claude
FIRSTDRAFT_AI_PROVIDER=Codex

# Whether the worker asks the AI tool to perform a planning pass before
# implementation. Accepted boolean values include true/false.
FIRSTDRAFT_PLANNING_ENABLED=true

# Directory used as the base working directory for AI commands. This must exist
# when the worker loads configuration. "." means the current directory.
FIRSTDRAFT_AI_WORKING_DIRECTORY=.

# Worker application folder. This is local worker state, not a Git repository
# path. Keep the default unless you intentionally store worker app files
# elsewhere.
FIRSTDRAFT_APPLICATION_FOLDER=App

# Folder for worker logs. Relative paths are resolved from the worker's current
# directory.
FIRSTDRAFT_LOGS_FOLDER=Logs

# Comma-separated application paths this worker advertises to the API and grants
# to AI commands in addition to FIRSTDRAFT_AI_WORKING_DIRECTORY.
#
# Use "*" or an empty value for no explicit extra paths; the setup wizard shows
# that default as "*". Multiple concrete paths can be comma-separated.
FIRSTDRAFT_APPLICATION_PATHS=*

# Comma-separated skill labels this worker advertises, normalized by the worker.
#
# Use "none" or an empty value for no advertised skills. gitflow work requires
# the "git" skill, so keep "git" for normal repository workers.
FIRSTDRAFT_SKILLS=git

# Maximum number of concurrent gitflow tasks this worker may run.
#
# Use an integer from 1 to 8. Use "unlimited", "null", or an empty value for
# unlimited capacity.
FIRSTDRAFT_MAX_CONCURRENT_TASKS=1

# Optional workspace root for gitflow repository work. Leave empty to use the
# worker's normal working-directory behavior.
FIRSTDRAFT_GIT_WORKSPACE_DIRECTORY=

# Optional display name shown in the API and web console. Leave empty to omit.
FIRSTDRAFT_NAME=

# Optional comma-separated tags shown in the API and web console. Use "none" or
# an empty value for no tags.
FIRSTDRAFT_TAGS=

# -----------------------------------------------------------------------------
# Optional on-site worker authentication
# -----------------------------------------------------------------------------
#
# Use only when the API is configured with matching WORKER_API_KEY and
# WORKER_API_SECRET values.
#
# Both values must be set together. If either one is set without the other, the
# worker configuration is invalid.
# WORKER_API_KEY=
# WORKER_API_SECRET=

# -----------------------------------------------------------------------------
# Optional Git repository bootstrap
# -----------------------------------------------------------------------------
#
# Use indexed groups to preconfigure repositories from .env. Repeat the same
# shape with FIRSTDRAFT_GIT_2_*, FIRSTDRAFT_GIT_3_*, and so on.
#
# REPOSITORY_URL is required for each indexed repository. SOURCE_BRANCH defaults
# to main when omitted. TARGET_BRANCH defaults to SOURCE_BRANCH when omitted.
#
# Entries override existing repositories with the same normalized repository
# URL. Source and target branches are enforced for Jira-claimed gitflow work.
# FIRSTDRAFT_GIT_1_REPOSITORY_URL=https://github.com/example/repo.git
# FIRSTDRAFT_GIT_1_SOURCE_BRANCH=main
# FIRSTDRAFT_GIT_1_TARGET_BRANCH=main

# -----------------------------------------------------------------------------
# Optional Jira integration bootstrap
# -----------------------------------------------------------------------------
#
# Use indexed groups to preconfigure Jira integrations from .env. Repeat the
# same shape with FIRSTDRAFT_JIRA_2_*, FIRSTDRAFT_JIRA_3_*, and so on.
#
# ID is optional. If omitted, the worker derives a stable 5-character ID from
# the index, such as jir01 for FIRSTDRAFT_JIRA_1_*. If provided, it must be 5
# lowercase alphanumeric characters.
#
# ENABLED defaults to true. SITE_URL is required for new integrations and can be
# omitted only when updating an existing integration with the same ID in
# config.json.
#
# API_KEY is the Jira API token. API_TOKEN is also accepted for older files.
# Plaintext tokens are encrypted into config.json when the worker has a
# ConfigEncryptionKey. If the worker is not authenticated yet, `firstdraft init`
# encrypts the token after authentication. Remove plaintext API_KEY from .env
# once the encrypted token has been saved.
#
# BOARD_NAME and the three status names are resolved against Jira when a readable
# API token is available. Advanced fields such as BOARD_ID, BOARD_TYPE,
# BOARD_FILTER_ID, READY_STATUS_ID, PROCESSING_STATUS_ID, and
# PROCESSED_STATUS_ID are also supported when you need to pin exact Jira IDs.
#
# ASSIGNEES controls which Jira assignees this worker accepts:
#   any, none, or empty -> accept any assignee
#   accountId|displayName|emailAddress;accountId2|Name|email@example.com
#     -> restrict to explicit Jira users
# FIRSTDRAFT_JIRA_1_ID=jir01
# FIRSTDRAFT_JIRA_1_ENABLED=true
# FIRSTDRAFT_JIRA_1_SITE_URL=https://example.atlassian.net
# FIRSTDRAFT_JIRA_1_EMAIL=user@example.com
# FIRSTDRAFT_JIRA_1_API_KEY=
# FIRSTDRAFT_JIRA_1_BOARD_NAME=Engineering
# FIRSTDRAFT_JIRA_1_READY_STATUS=Ready for AI
# FIRSTDRAFT_JIRA_1_PROCESSING_STATUS=AI Processing
# FIRSTDRAFT_JIRA_1_PROCESSED_STATUS=Processed by AI
# FIRSTDRAFT_JIRA_1_ASSIGNEES=any
