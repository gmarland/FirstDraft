# FirstDraft web console environment template.
#
# Copy to app/.env.local for Vite local development:
#
#   cp .env.example .env.local
#
# Vite exposes only variables prefixed with VITE_ to browser code. This value is
# also used by the Docker nginx image at container startup to write runtime
# browser config, so the same variable name works for source builds and Docker.

# Base URL for the FirstDraft API as seen from the user's browser, not from the
# web server container.
#
# Local source or root docker-compose.yml default:
#   http://localhost:5080
#
# Hosted example:
#   https://api.example.com
#
# Do not include a trailing slash. The app appends API paths such as /api/auth.
VITE_API_BASE_URL=http://localhost:5080
